<AIWorkflowAppBundle #depa.flows.test.SupportAgent envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "Support agent workflow app"
} (
  <WorkflowBindings [
    <WorkflowBinding #primary {
      kind = "AICtrlWorkflow"
      ref = "resource://depa.flows.test.SupportAgent.Workflow"
      entrypoint = true
    }>
    <WorkflowBinding #evidence {
      kind = "AIDataWorkflow"
      ref = "resource://depa.flows.test.SupportAgent.Evidence"
      entrypoint = false
    }>
  ]>
)>
