<ResourcePackage #depa.flows.test.agent_executable_overlay envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "Executable Agent contract overlay"
} (
  <Catalogs [
    <Catalog #kind_definitions { kind = "KindDefinition" shape = "directory" root = "vfs://./KindDefinitions/" entry = "manifest.xnl" }>
    <Catalog #schemas { kind = "MessageSchema" shape = "single-file" root = "vfs://./Schemas/" }>
    <Catalog #policies { kind = "EffectPolicy" shape = "single-file" root = "vfs://./Policies/" }>
    <Catalog #materials { kind = "RequestMaterial" shape = "single-file" root = "vfs://./RequestMaterials/" }>
  ]>
)>
