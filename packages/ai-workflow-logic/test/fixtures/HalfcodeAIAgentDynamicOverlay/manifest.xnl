<ResourcePackage #depa.flows.test.agent_dynamic_overlay envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "Selected Agent message source overlay"
} (
  <Catalogs [
    <Catalog #kind_definitions { kind = "KindDefinition" shape = "directory" root = "vfs://./KindDefinitions/" entry = "manifest.xnl" }>
    <Catalog #agent_message_sources { kind = "AgentMessageSource" shape = "single-file" root = "vfs://./MessageSources/" }>
  ]>
)>
