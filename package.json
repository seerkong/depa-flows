{
  "name": "depa-flows",
  "private": true,
  "version": "0.0.0",
  "description": "depa-flows workspace root (bun monorepo)",
  "workspaces": [
    "packages/*",
    "tools/*",
    "../depa-processor"
  ],
  "scripts": {
