              </?01M17DRPAKS2R3FWEWXKCTS29R>
            ]>
          )>
          <Task #P2-T2 { name = "Implement projection digest and admission" status = "DONE" priority = "P0" order = 1 } (
            <Acceptance [
              <Criterion #P2-T2-AC1 { checked = true } ?01M17DRPAKS2R3FWEWXKCTS29S>
