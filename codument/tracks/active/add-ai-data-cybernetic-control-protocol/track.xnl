              </?>
              <Criterion #P4-T1-AC2 { checked = false } ?>
              Packed artifacts contain the autonomous control exports and pass focused tests, typecheck and tarball smoke import.
              </?>
            ]>
          )>
          <Task #P4-T2 { name = "Publish and verify npm authority" status = "NOT_STARTED" priority = "P0" order = 1 } (
            <Acceptance [
