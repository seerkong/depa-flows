        </?01M17DRPAKS2R3FWEWXKCTS29X>
        <SubNodes [
          <Task #P3-T1 { name = "Run focused and workspace verification" status = "DONE" priority = "P1" order = 0 } (
            <Acceptance [
              <Criterion #P3-T1-AC1 { checked = true } ?01M17DRPAKS2R3FWEWXKCTS29Y>
              Focused tests, full workspace tests, typecheck and strict Codument validation pass.
              </?01M17DRPAKS2R3FWEWXKCTS29Y>
              <Criterion #P3-T1-AC2 { checked = true } ?01M17DRPAKS2R3FWEWXKCTS29Z>
              Static review finds no provider/host import, implicit graph mutation, arbitrary executable reference or copied graph state.
              </?01M17DRPAKS2R3FWEWXKCTS29Z>
            ]>
          )>
        ]>
        <Hooks [
          <Hook { on = "phase:after" } (
            <AttractorCheck { use = "coding" }>
          )>
        ]>
        <Gate [
          <Criterion #P3-G1 { checked = true } ?01M17DRPAKS2R3FWEWXKCTS2A0>
          Independent direction review reports no P0/P1 authority, Data, Processor or bounded-control gap.
          </?01M17DRPAKS2R3FWEWXKCTS2A0>
        ]>
      )>
      <TaskGroup #P4 { name = "Publish consumable control libraries" status = "NOT_STARTED" priority = "P0" order = 3 } (
        <Description ?>
