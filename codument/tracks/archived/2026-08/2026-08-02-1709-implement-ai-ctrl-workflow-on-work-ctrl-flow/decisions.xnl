<decisions #implement-ai-ctrl-workflow-on-work-ctrl-flow apiVersion="codument.tech/v1alpha1" { version = "1" } (
  <decision #track.agent.substrate { status = "accepted" priority = "P0" } (
    <question ?01M0NJZ4R48348H77EE0WPWXET>
    What engine owns AI Ctrl Workflow execution?
    </?01M0NJZ4R48348H77EE0WPWXET>
    <answer ?01M0NJZ4R48348H77EE0WPWXEV>
    WorkCtrlFlowEngine owns execution; AI Ctrl Workflow is an adapter/profile layer.
    </?01M0NJZ4R48348H77EE0WPWXEV>
    <rationale ?01M0NJZ4R48348H77EE0WPWXEW>
    This preserves durable WorkCtrlFlow semantics and avoids another flow engine.
    </?01M0NJZ4R48348H77EE0WPWXEW>
  )>
)>
