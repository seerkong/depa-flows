<Track #publish-ai-workflow-flow-dsl-reference-module version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Publish canonical depa Flow DSL documentation as a versioned, package-contained authoring reference module for downstream Skill composition." description = "Generate one deterministic Halfcode ResourcePackage module from docs/flow-dsl, publish it as a dedicated package, and let downstream Skills embed selected references without duplicating Eidolon host policy or creating another installed system Skill." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-16T13:24:41Z" updated_at = "2026-08-16T14:10:00Z" } (
