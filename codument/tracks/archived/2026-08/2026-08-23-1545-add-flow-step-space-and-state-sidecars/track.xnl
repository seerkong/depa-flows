<Track #add-flow-step-space-and-state-sidecars apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Add a modular StepSpace definition domain and step-local immutable run records while preserving one canonical FlowRunCheckpoint authority." description = "Build and publish generic StepSpace contracts/logic, profile assembly and a root-last filesystem sidecar codec with bounded local writes, fresh recovery and no second authority." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-23T08:26:17.365Z" updated_at = "2026-08-23T12:45:52.543Z" modeling_base_commit = "91ac3156c2635680e3a1b8e74c4da0349c034716" engineering_base_commit = "91ac3156c2635680e3a1b8e74c4da0349c034716" gap_round = 3 } (
