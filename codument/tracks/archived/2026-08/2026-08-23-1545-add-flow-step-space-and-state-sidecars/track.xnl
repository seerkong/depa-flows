      </?01M0PYNPC1H9WM62GB1Q8HH458>
      <Port #flow-dsl-reference { role = "output" domain = "docs" } ?01M0PYNPC1H9WM62GB1Q8HH459>
      Regenerated and published Flow DSL reference
      </?01M0PYNPC1H9WM62GB1Q8HH459>
    ]>
  )>
  <TaskSpace #space_add-flow-step-space-and-state-sidecars { name = "add-flow-step-space-and-state-sidecars" version = "1" child_mode = "dag" } (
    <SubNodes [
      <TaskGroup #P1 { name = "StepSpace contracts and invariants" status = "DONE" priority = "P0" order = 0 } (
        <Description ?01M0PYNPC1H9WM62GB1Q8HH45A>
        Freeze the DataTopology, public contracts and RED evidence before changing profile loaders or persistence.
        </?01M0PYNPC1H9WM62GB1Q8HH45A>
        <SubNodes [
          <Task #P1-T1 { name = "Freeze StepSpace and single-head authority" status = "DONE" priority = "P0" order = 0 } (
            <Description ?01M0PYNPC1H9WM62GB1Q8HH45B>
            Record package×module evidence, closed Step/Group/Extension contracts, DefinitionStepForest versus RunStepStateIndex, root-head authority, transition formula and compatibility boundary.
            </?01M0PYNPC1H9WM62GB1Q8HH45B>
            <Acceptance [
              <Criterion #P1-T1-AC1 { checked = true } ?01M0PYNPC1H9WM62GB1Q8HH45C>
              The design and tests distinguish immutable definition facts, one checkpoint current authority, immutable record material and rebuildable observations.
              </?01M0PYNPC1H9WM62GB1Q8HH45C>
              <Criterion #P1-T1-AC2 { checked = true } ?01M0PYNPC1H9WM62GB1Q8HH45D>
              StepSpace and TaskSpace remain separate owners with one exact BPCtrl bridge and no copied task status.
              </?01M0PYNPC1H9WM62GB1Q8HH45D>
              <Criterion #P1-T1-AC3 { checked = true } ?01M0PYNPC1H9WM62GB1Q8HH45E>
              Package ownership is frozen: flow-step-space owns definition/pure Merkle contracts, while ai-workflow-logic alone owns profile partition, filesystem IO and authoritative head admission.
              </?01M0PYNPC1H9WM62GB1Q8HH45E>
            ]>
          )>
          <Task #P1-T2 { name = "Implement closed StepSpace packages" status = "DONE" priority = "P0" order = 1 } (
            <Description ?01M0PYNPC1H9WM62GB1Q8HH45F>
            Create flow-step-space-contract/logic with exact recursive definitions, explicit refs, extension registry, pure normalizers and runtime-first mutation processors.
            </?01M0PYNPC1H9WM62GB1Q8HH45F>
            <Acceptance [
              <Criterion #P1-T2-AC1 { checked = true } ?01M0PYNPC1H9WM62GB1Q8HH45G>
              Unknown/duplicate ids, cyclic refs, inline+StepSpace dual topology, undeclared extensions, traversal, symlink and accessor/sparse structures fail before owner mutation.
              </?01M0PYNPC1H9WM62GB1Q8HH45G>
              <Criterion #P1-T2-AC2 { checked = true } ?01M0PYNPC1H9WM62GB1Q8HH45H>
              The public Processor shapes keep explicit runtime and never expose physical filesystem paths as semantic inputs.
              </?01M0PYNPC1H9WM62GB1Q8HH45H>
            ]>
          )>
        ]>
        <Gate [
          <Criterion #P1-G1 { checked = true } ?01M0PYNPC1H9WM62GB1Q8HH45J>
