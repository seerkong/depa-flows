<Track #add-typed-agent-invocation-and-instance-selection apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "Add runtime-first typed Agent invocation, exact instance selection and Ctrl/Data DSL bindings on the canonical Flow checkpoint authority." description = "Introduce named Processors and authored facades, closed selectors, recoverable run-local Agent indexes and profile-specific task semantics without adding a host runtime or second state owner." question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-23T01:45:42.053Z" updated_at = "2026-08-23T03:16:33.306Z" } (
