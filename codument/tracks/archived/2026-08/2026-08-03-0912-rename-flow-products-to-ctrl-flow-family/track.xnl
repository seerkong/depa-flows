          <Task { id = "T3.2" name = "Rename AICtrlWorkflow root, example bundle and AI workflow profile docs" status = "DONE" order = 1 }>
          <Task { id = "T3.3" name = "Update flow-dsl docs, product matrix and reading order" status = "DONE" order = 2 }>
          <Task { id = "T3.4" name = "Update checker/load rules to accept canonical roots and reject old current-authoring roots" status = "DONE" order = 3 }>
        ]>
      )>
      <TaskGroup #P4 { name = "Codument current-truth synchronization" status = "DONE" order = 3 } (
        <Description ?01M0NJZ4SGJ6M2D8RGCN23HA1F>
