<Track #rename-flow-products-to-ctrl-flow-family version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "Rename flow products into the canonical ctrl-flow and AI workflow naming families." description = "Plan a clean breaking rename from InstantFlow, WorkFlow, BizProcess and AIAgentWorkflow to InstantCtrlFlow, WorkCtrlFlow, BPCtrlFlow and AICtrlWorkflow across packages, APIs, XNL roots, docs, examples, behaviors and current Codument artifacts." question_mode = "decision-tree" question_severity = "light" commit_mode = "manual" created_at = "2026-08-03T05:55:23Z" updated_at = "2026-08-03T06:12:21Z" } (
  <Ports { scope = "track" } [
    <MaterialBundle { role = "input" name = "behavior-deltas" domain = "behavior" path = "vfs://./behavior_deltas/" }>
