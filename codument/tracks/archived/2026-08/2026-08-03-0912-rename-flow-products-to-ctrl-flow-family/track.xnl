    <MaterialBundle { role = "output" name = "examples" domain = "example" path = "vfs://@/examples/xnl-bundles/" }>
    <MaterialBundle { role = "output" name = "behavior" domain = "codument" path = "vfs://@/codument/behaviors/" }>
  ]>
