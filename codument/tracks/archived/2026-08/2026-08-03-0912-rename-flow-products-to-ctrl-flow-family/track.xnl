          <Task { id = "T4.3" name = "Update pending Eidolon workflow boundary track to AICtrlWorkflow terminology" status = "DONE" order = 2 }>
          <Task { id = "T4.4" name = "Review modeling and engineering registries for current-truth old names" status = "DONE" order = 3 }>
        ]>
      )>
      <TaskGroup #P5 { name = "Validation and hygiene" status = "DONE" order = 4 } (
        <Description ?01M0NJZ4SGJ6M2D8RGCN23HA1G>
