          <Task { id = "T1.3" name = "Define no-public-legacy-alias migration policy" status = "DONE" order = 2 }>
        ]>
      )>
      <TaskGroup #P2 { name = "Package and TypeScript API rename" status = "DONE" order = 1 } (
        <Description ?01M0NJZ4SGJ6M2D8RGCN23HA1D>
        Rename workspace packages, dependencies, imports, exports, runtime helpers and tests.
        </?01M0NJZ4SGJ6M2D8RGCN23HA1D>
        <SubNodes [
          <Task { id = "T2.1" name = "Rename instant-flow packages and APIs to instant-ctrl-flow / InstantCtrlFlow" status = "DONE" order = 0 }>
          <Task { id = "T2.2" name = "Rename work-flow packages and APIs to work-ctrl-flow / WorkCtrlFlow" status = "DONE" order = 1 }>
          <Task { id = "T2.3" name = "Rename biz-process packages and APIs to bp-ctrl-flow / BPCtrlFlow" status = "DONE" order = 2 }>
          <Task { id = "T2.4" name = "Rename ai-agent-workflow packages and APIs to ai-ctrl-workflow / AICtrlWorkflow" status = "DONE" order = 3 }>
          <Task { id = "T2.5" name = "Preserve shared ai-workflow, ai-data-workflow and eager-data-flow APIs where semantically shared or unchanged" status = "DONE" order = 4 }>
        ]>
      )>
      <TaskGroup #P3 { name = "XNL, docs, examples and checker rename" status = "DONE" order = 2 } (
        <Description ?01M0NJZ4SGJ6M2D8RGCN23HA1E>
        Move current authoring surface to new root tags, schemes, directories and examples.
        </?01M0NJZ4SGJ6M2D8RGCN23HA1E>
