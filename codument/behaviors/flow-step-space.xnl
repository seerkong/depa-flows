<Behavior #flow-step-space apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #modular-step-definition (
      <Statement ?01M0QAGC9NVSE9RBDVEC2T65DR>
      A Flow definition MAY use one explicit StepSpace reference whose recursive StepRefs and ExtensionRefs assemble an immutable DefinitionStepForest and canonical profile topology; inline topology and StepSpace topology SHALL be mutually exclusive, and assembly SHALL NOT discover files by scanning directories.
      </?01M0QAGC9NVSE9RBDVEC2T65DR>
      <Suites [
        <Suite #definition-assembly { name = "Modular step definition assembly" } (
          <Cases [
            <Case #local-step-edit (
              <Given ?01M0QAGC9NVSE9RBDVEC2T65DS>
              a StepSpace with multiple externally referenced step and extension files
              </?01M0QAGC9NVSE9RBDVEC2T65DS>
              <When ?01M0QAGC9NVSE9RBDVEC2T65DT>
              one step extension is edited and the definition is reassembled
              </?01M0QAGC9NVSE9RBDVEC2T65DT>
              <Then ?01M0QAGC9NVSE9RBDVEC2T65DV>
              only that file and the complete artifact digest SHALL change while unrelated bytes remain identical
              </?01M0QAGC9NVSE9RBDVEC2T65DV>
            )>
            <Case #single-topology-owner (
              <Given ?01M0QAGC9NVSE9RBDVEC2T65DW>
              a profile root declares both inline executable nodes and a StepSpaceRef, or two refs resolve the same step id
              </?01M0QAGC9NVSE9RBDVEC2T65DW>
              <When ?01M0QAGC9NVSE9RBDVEC2T65DX>
              the profile loader admits the definition
              </?01M0QAGC9NVSE9RBDVEC2T65DX>
              <Then ?01M0QAGC9NVSE9RBDVEC2T65DY>
              it SHALL fail closed before instance materialization without choosing or merging authorities
              </?01M0QAGC9NVSE9RBDVEC2T65DY>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #step-record-authority (
      <Statement ?01M0QAGC9NVSE9RBDVEC2T65DZ>
      A filesystem run SHALL keep one checkpoint head as current authority and SHALL store step core and registered extension facts as immutable digest-bound records selected by one accepted RunStepStateIndex root; runtime index membership SHALL derive only from the frozen profile binding plus accepted canonical patch/orchestration facts.
      </?01M0QAGC9NVSE9RBDVEC2T65DZ>
      <Suites [
        <Suite #root-admission { name = "Root-last step record admission" } (
          <Cases [
            <Case #local-transition (
              <Given ?01M0QAGC9NVSE9RBDVEC2T65E0>
              a run with many accepted step records
              </?01M0QAGC9NVSE9RBDVEC2T65E0>
              <When ?01M0QAGC9P2HN89PP8EP9X3ZKC>
              one step core or extension fact changes
              </?01M0QAGC9P2HN89PP8EP9X3ZKC>
              <Then ?01M0QAGC9P2HN89PP8EP9X3ZKD>
              the store SHALL write only changed records, the logarithmic tree path and one new checkpoint head; untouched records SHALL remain byte-identical
              </?01M0QAGC9P2HN89PP8EP9X3ZKD>
            )>
            <Case #interrupted-candidate (
              <Given ?01M0QAGC9P2HN89PP8EP9X3ZKE>
              candidate records are durable but their checkpoint head was not admitted
              </?01M0QAGC9P2HN89PP8EP9X3ZKE>
              <When ?01M0QAGC9P2HN89PP8EP9X3ZKF>
              a fresh process loads the run
              </?01M0QAGC9P2HN89PP8EP9X3ZKF>
              <Then ?01M0QAGC9P2HN89PP8EP9X3ZKG>
              it SHALL restore the previous head and ignore the unreachable candidate records
              </?01M0QAGC9P2HN89PP8EP9X3ZKG>
            )>
            <Case #dynamic-membership (
              <Given ?01M0QAGC9P2HN89PP8EP9X3ZKH>
              an AIData patch adds, updates or removes a node, or Ctrl orchestration admits a composite child
              </?01M0QAGC9P2HN89PP8EP9X3ZKH>
              <When ?01M0QAGC9P2HN89PP8EP9X3ZKJ>
              the runtime state index changes membership
              </?01M0QAGC9P2HN89PP8EP9X3ZKJ>
              <Then ?01M0QAGC9P2HN89PP8EP9X3ZKK>
              the change SHALL be exactly explained by the accepted logical profile fact and SHALL NOT establish an independent topology authority
              </?01M0QAGC9P2HN89PP8EP9X3ZKK>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
