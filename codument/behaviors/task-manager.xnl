<Behavior #task-manager apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #status-machine (
      <Statement ?01M0NJZ4NC4S26V924HD9Q1HTK>
      任务状态机 SHALL 遵守 task-manager-contract：NOT_STARTED→[ACTIVE,ABANDONED]；ACTIVE→[DONE,REFUSED,FORWARDED,DELEGATED,NOT_STARTED,ABANDONED]；DELEGATED→[ACTIVE,ABANDONED]；DONE/REFUSED/FORWARDED/ABANDONED 为终态；非法转移抛错；ACTIVE 记 startedAt、终态记 endedAt。
      </?01M0NJZ4NC4S26V924HD9Q1HTK>
      <Suites [
        <Suite { name = "status-machine" } (
          <Cases [
            <Case { name = "非法转移" } (
              <Given ?01M0NJZ4NC4S26V924HD9Q1HTM>
              终态任务或 NOT_STARTED 任务
              </?01M0NJZ4NC4S26V924HD9Q1HTM>
              <When ?01M0NJZ4NC4S26V924HD9Q1HTN>
              再操作 / 直接 complete
              </?01M0NJZ4NC4S26V924HD9Q1HTN>
              <Then ?01M0NJZ4NC4S26V924HD9Q1HTP>
              抛 TaskTransitionError
              </?01M0NJZ4NC4S26V924HD9Q1HTP>
            )>
            <Case { name = "委派链" } (
              <Given ?01M0NJZ4NC4S26V924HD9Q1HTQ>
              ACTIVE 任务
              </?01M0NJZ4NC4S26V924HD9Q1HTQ>
              <When ?01M0NJZ4NC4S26V924HD9Q1HTR>
              delegate→reactivate→complete
              </?01M0NJZ4NC4S26V924HD9Q1HTR>
              <Then ?01M0NJZ4NC4S26V924HD9Q1HTS>
              各步合法收敛 DONE
              </?01M0NJZ4NC4S26V924HD9Q1HTS>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #group-aggregation (
      <Statement ?01M0NJZ4NC4S26V924HD9Q1HTT>
      TaskGroup SHALL 按 executionMode 聚合终态：SEQUENTIAL/ALL 全 done-like→DONE、任一失败终态提前→REFUSED；ANY 任一 done-like→DONE、全失败终态→REFUSED；FORWARDED 视同 DONE；未收敛返回 undefined。
      </?01M0NJZ4NC4S26V924HD9Q1HTT>
      <Suites [
        <Suite { name = "group-aggregation" } (
          <Cases [
            <Case { name = "三种模式" } (
              <Given ?01M0NJZ4NC4S26V924HD9Q1HTV>
              各状态组合
              </?01M0NJZ4NC4S26V924HD9Q1HTV>
              <When ?01M0NJZ4NC4S26V924HD9Q1HTW>
              terminalStatusOf
              </?01M0NJZ4NC4S26V924HD9Q1HTW>
              <Then ?01M0NJZ4NC4S26V924HD9Q1HTX>
              见 statusMachine.test.ts 组聚合 suite
              </?01M0NJZ4NC4S26V924HD9Q1HTX>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
