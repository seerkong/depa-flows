<Behavior #flow-profile-runtime apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #persisted-branch-decisions (
      <Statement ?01M0QP09MH0T1VMPS1KGG1XT1H>
      WorkCtrlFlow and BPCtrlFlow SHALL persist each selected If branch before entering its body and SHALL reuse that decision after suspension or restart without re-evaluating completed predicates.
      </?01M0QP09MH0T1VMPS1KGG1XT1H>
      <Suites [
        <Suite #resume (
          <Cases [
            <Case #no-re-evaluation (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT1J>
              a flow selected a branch then suspended
              </?01M0QP09MH0T1VMPS1KGG1XT1J>
              <When ?01M0QP09MH0T1VMPS1KGG1XT1K>
              it resumes after restart
              </?01M0QP09MH0T1VMPS1KGG1XT1K>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT1M>
              the selected branch SHALL be reused and predicate code SHALL not run again
              </?01M0QP09MH0T1VMPS1KGG1XT1M>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #task-step-result-data (
      <Statement ?01M0QP09MH0T1VMPS1KGG1XT1N>
      BPCtrlFlow TaskStep SHALL output task outcome data for approved, refused, forwarded and abandoned states; business outcomes MUST NOT be converted to technical success/failure routing.
      </?01M0QP09MH0T1VMPS1KGG1XT1N>
      <Suites [
        <Suite #task-outcome (
          <Cases [
            <Case #refusal (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT1P>
              a task becomes Refused
              </?01M0QP09MH0T1VMPS1KGG1XT1P>
              <When ?01M0QP09MH0T1VMPS1KGG1XT1Q>
              TaskStep resumes
              </?01M0QP09MH0T1VMPS1KGG1XT1Q>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT1R>
              the next If SHALL receive outcome refused and the flow SHALL remain technically healthy
              </?01M0QP09MH0T1VMPS1KGG1XT1R>
            )>
            <Case #forward (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT1S>
              a task becomes Forwarded
              </?01M0QP09MH0T1VMPS1KGG1XT1S>
              <When ?01M0QP09MH0T1VMPS1KGG1XT1T>
              TaskStep resumes
              </?01M0QP09MH0T1VMPS1KGG1XT1T>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT1V>
              the next If SHALL receive outcome forwarded as data
              </?01M0QP09MH0T1VMPS1KGG1XT1V>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #step-sidecar-checkpoint-projection (
      <Statement ?01M0QP09MH0T1VMPS1KGG1XT1W>
      Step-local physical records SHALL reconstruct the same closed logical FlowRunCheckpoint and SHALL pass all profile, Agent, version, terminal and reciprocal transition validators before a new head is admitted; unknown extension kinds or direct physical writes SHALL fail closed.
      </?01M0QP09MH0T1VMPS1KGG1XT1W>
      <Suites [
        <Suite #logical-equivalence { name = "Logical checkpoint equivalence" } (
          <Cases [
            <Case #memory-filesystem-equivalence (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT1X>
              the same accepted logical transition is committed through memory and sidecar filesystem stores
              </?01M0QP09MH0T1VMPS1KGG1XT1X>
              <When ?01M0QP09MH0T1VMPS1KGG1XT1Y>
              both checkpoints are loaded
              </?01M0QP09MH0T1VMPS1KGG1XT1Y>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT1Z>
              their normalized logical values and derived projections SHALL be exactly equal
              </?01M0QP09MH0T1VMPS1KGG1XT1Z>
            )>
            <Case #legacy-one-way-import (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT20>
              a valid direct logical checkpoint from the prior storage schema
              </?01M0QP09MH0T1VMPS1KGG1XT20>
              <When ?01M0QP09MH0T1VMPS1KGG1XT21>
              the sidecar store performs the next transition
              </?01M0QP09MH0T1VMPS1KGG1XT21>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT22>
              it SHALL import once, preserve the logical value and thereafter write only the new head/record form without dual-writing
              </?01M0QP09MH0T1VMPS1KGG1XT22>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #canonical-run-checkpoint (
      <Statement ?01M0QP09MH0T1VMPS1KGG1XT23>
      一个 run 的 input、config、state、output、controller/node sidecars 与 profile-owned durable state SHALL 由同一个 CAS-versioned checkpoint拥有；profile runtime不得建立并列可写store。
      </?01M0QP09MH0T1VMPS1KGG1XT23>
      <Suites [
        <Suite #typed-profile-state { name = "typed profile state" } (
          <Cases [
            <Case #ctrl-profile { name = "Ctrl profile" } (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT24>
              AICtrlWorkflow 使用 WorkCtrlFlow snapshot
              </?01M0QP09MH0T1VMPS1KGG1XT24>
              <When ?01M0QP09MH0T1VMPS1KGG1XT25>
              wait、resume、branch decision或AI profile state改变
              </?01M0QP09MH0T1VMPS1KGG1XT25>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT26>
              变化 SHALL 作为一个checkpoint transition提交并从同一version恢复
              </?01M0QP09MH0T1VMPS1KGG1XT26>
            )>
            <Case #data-profile { name = "Data profile" } (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT27>
              AIDataWorkflow 使用 RunGraph
              </?01M0QP09MH0T1VMPS1KGG1XT27>
              <When ?01M0QP09MH0T1VMPS1KGG1XT28>
              generation、invalidation或AI profile state改变
              </?01M0QP09MH0T1VMPS1KGG1XT28>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT29>
              变化 SHALL 作为一个checkpoint transition提交，不得另写并列data-graph authority
              </?01M0QP09MH0T1VMPS1KGG1XT29>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #external-runtime-reference-boundary (
      <Statement ?01M0QP09MH0T1VMPS1KGG1XT2A>
      AI Workflow profile state MAY 保存外部 Agent actor/session/instance的opaque stable references与receipts，但 MUST NOT 复制conversation、history、compaction或external actor state；外部runtime继续拥有其execution authority。
      </?01M0QP09MH0T1VMPS1KGG1XT2A>
      <Suites [
        <Suite #external-reference { name = "外部runtime引用" } (
          <Cases [
            <Case #reference-only-recovery { name = "仅引用恢复" } (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT2B>
              checkpoint保存一个external runtime stable reference
              </?01M0QP09MH0T1VMPS1KGG1XT2B>
              <When ?01M0QP09MH0T1VMPS1KGG1XT2C>
              fresh host恢复workflow run
              </?01M0QP09MH0T1VMPS1KGG1XT2C>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT2D>
              profile SHALL 通过host adapter解析该reference，不得从checkpoint伪造或复制external actor state
              </?01M0QP09MH0T1VMPS1KGG1XT2D>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #agent-instance-checkpoint-authority (
      <Statement ?01M0QP09MH0T1VMPS1KGG1XT2E>
      A Flow run's canonical checkpoint AI profile SHALL be the single workflow owner of Agent instance indexes, stable external references and invocation receipts.
      </?01M0QP09MH0T1VMPS1KGG1XT2E>
      <Suites [
        <Suite #run-local-index { name = "Run-local Agent index" } (
          <Cases [
            <Case #unique-instance-name (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT2F>
              two nodes in one Flow run reserve the same authored Agent instance name
              </?01M0QP09MH0T1VMPS1KGG1XT2F>
              <When ?01M0QP09MH0T1VMPS1KGG1XT2G>
              checkpoint compare-and-swap chooses the accepted reservation
              </?01M0QP09MH0T1VMPS1KGG1XT2G>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT2H>
              exactly one name-to-id binding SHALL exist and the other invocation SHALL fail before creating a host instance
              </?01M0QP09MH0T1VMPS1KGG1XT2H>
            )>
            <Case #stable-reference-only (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT2J>
              a host Agent instance has actor, session and provider-owned runtime state
              </?01M0QP09MH0T1VMPS1KGG1XT2J>
              <When ?01M0QP09MH0T1VMPS1KGG1XT2K>
              the Flow checkpoint records its reusable binding
              </?01M0QP09MH0T1VMPS1KGG1XT2K>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT2M>
              the checkpoint SHALL store only closed opaque stable references and receipts and SHALL reject conversation, history, compaction or actor state
              </?01M0QP09MH0T1VMPS1KGG1XT2M>
            )>
          ]>
        )>
        <Suite #invocation-recovery { name = "Invocation recovery" } (
          <Cases [
            <Case #resume-pending-invocation (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT2N>
              an Agent invocation reservation is accepted but its completion is not yet in the checkpoint
              </?01M0QP09MH0T1VMPS1KGG1XT2N>
              <When ?01M0QP09MH0T1VMPS1KGG1XT2P>
              a fresh process continues the same node invocation
              </?01M0QP09MH0T1VMPS1KGG1XT2P>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT2Q>
              it SHALL reuse the same invocation key and host instance rather than create a second child
              </?01M0QP09MH0T1VMPS1KGG1XT2Q>
            )>
            <Case #return-completed-invocation (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT2R>
              a completed Agent invocation result and receipt are accepted in the checkpoint
              </?01M0QP09MH0T1VMPS1KGG1XT2R>
              <When ?01M0QP09MH0T1VMPS1KGG1XT2S>
              the same node execution is reconstructed
              </?01M0QP09MH0T1VMPS1KGG1XT2S>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT2T>
              it SHALL return the durable result and stable instance identity without redispatch
              </?01M0QP09MH0T1VMPS1KGG1XT2T>
            )>
            <Case #single-checkpoint-transition (
              <Given ?01M0QP09MH0T1VMPS1KGG1XT2V>
              Ctrl snapshot or Data RunGraph state advances with an Agent receipt
              </?01M0QP09MH0T1VMPS1KGG1XT2V>
              <When ?01M0QP09MH0T1VMPS1KGG1XT2W>
              the transition is committed
              </?01M0QP09MH0T1VMPS1KGG1XT2W>
              <Then ?01M0QP09MH0T1VMPS1KGG1XT2X>
              profile state and controller state SHALL advance under one checkpoint version and SHALL NOT be dual-written to another Agent state store
              </?01M0QP09MH0T1VMPS1KGG1XT2X>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
