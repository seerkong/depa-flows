<Behavior #instant-ctrl-flow-engine apiVersion="codument.tech/v1alpha1" version="1" (
  <Requirements [
    <Requirement #stateless-run (
      <Statement ?01M0NJZ4MXXD9NEN3RMDK52JGH>
      runInstantCtrlFlow(bundleDir, {input, runtime}) SHALL 加载 InstantCtrlFlow xnl bundle、编译为行为树并在一次调用内收敛，返回 {success, vars, logs, errors}；不保存任何跨调用状态；同一 bundle 可重复执行且互不影响（IF-1/IF-4）。
      </?01M0NJZ4MXXD9NEN3RMDK52JGH>
      <Suites [
        <Suite { name = "stateless-run" } (
          <Cases [
            <Case { name = "健康路径" } (
              <Given ?01M0NJZ4MXXD9NEN3RMDK52JGJ>
              instant-http-check 演示 bundle 与 stub fetch(200)
              </?01M0NJZ4MXXD9NEN3RMDK52JGJ>
              <When ?01M0NJZ4MXXD9NEN3RMDK52JGK>
              runInstantCtrlFlow
              </?01M0NJZ4MXXD9NEN3RMDK52JGK>
              <Then ?01M0NJZ4MXXD9NEN3RMDK52JGM>
              success=true，vars.ok=true，vars.attempts=1，config://#ping/url 已在编译期解析
              </?01M0NJZ4MXXD9NEN3RMDK52JGM>
            )>
            <Case { name = "重试与断言失败" } (
              <Given ?01M0NJZ4MXXD9NEN3RMDK52JGN>
              stub fetch(500)
              </?01M0NJZ4MXXD9NEN3RMDK52JGN>
              <When ?01M0NJZ4MXXD9NEN3RMDK52JGP>
              runInstantCtrlFlow
              </?01M0NJZ4MXXD9NEN3RMDK52JGP>
              <Then ?01M0NJZ4MXXD9NEN3RMDK52JGQ>
              Until 重试至 config.maxAttempts=3 次后 Assert 失败，success=false
              </?01M0NJZ4MXXD9NEN3RMDK52JGQ>
            )>
            <Case { name = "可重复执行" } (
              <Given ?01M0NJZ4MXXD9NEN3RMDK52JGR>
              同一 bundle 连续两次执行
              </?01M0NJZ4MXXD9NEN3RMDK52JGR>
              <When ?01M0NJZ4MXXD9NEN3RMDK52JGS>
              runInstantCtrlFlow ×2
              </?01M0NJZ4MXXD9NEN3RMDK52JGS>
              <Then ?01M0NJZ4MXXD9NEN3RMDK52JGT>
              两次结果一致，vars 互不泄漏
              </?01M0NJZ4MXXD9NEN3RMDK52JGT>
            )>
          ]>
        )>
      ]>
    )>
    <Requirement #if-narrowing (
      <Statement ?01M0NJZ4MXXD9NEN3RMDK52JGV>
      InstantCtrlFlow 引擎 SHALL 拒绝非 InstantCtrlFlow bundle（form-mismatch）与含可中断节点（ExternalJob/Timer/TaskStep）的树（编译期 interruptible-in-instant-ctrl-flow）。
      </?01M0NJZ4MXXD9NEN3RMDK52JGV>
      <Suites [
        <Suite { name = "if-narrowing" } (
          <Cases [
            <Case { name = "form 拒绝" } (
              <Given ?01M0NJZ4MXXD9NEN3RMDK52JGW>
              WorkCtrlFlow bundle
              </?01M0NJZ4MXXD9NEN3RMDK52JGW>
              <When ?01M0NJZ4MXXD9NEN3RMDK52JGX>
              loadInstantCtrlFlowSpec
              </?01M0NJZ4MXXD9NEN3RMDK52JGX>
              <Then ?01M0NJZ4MXXD9NEN3RMDK52JGY>
              抛 FlowLoadError(form-mismatch)
              </?01M0NJZ4MXXD9NEN3RMDK52JGY>
            )>
            <Case { name = "节点拒绝" } (
              <Given ?01M0NJZ4MXXD9NEN3RMDK52JGZ>
              含 ExternalJob 的树
              </?01M0NJZ4MXXD9NEN3RMDK52JGZ>
              <When ?01M0NJZ4MXXD9NEN3RMDK52JH0>
              compileBundle
              </?01M0NJZ4MXXD9NEN3RMDK52JH0>
              <Then ?01M0NJZ4MXXD9NEN3RMDK52JH1>
              抛 FlowCompileError(interruptible-in-instant-ctrl-flow)
              </?01M0NJZ4MXXD9NEN3RMDK52JH1>
            )>
          ]>
        )>
      ]>
    )>
  ]>
)>
